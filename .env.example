# Local Docker Compose only. Use a unique secret outside local development.
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST_PORT=5433
DENTSTAFF_HOST_PORT=8085
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-local-password
KEYCLOAK_HOST_PORT=8180
EMPLOYER_JOIN_CODE=replace-with-admin-issued-code
DENTSUITE_PUBLIC_WEB_URL=http://localhost:3000
EMAIL_FROM=noreply@dentsuite.local

# Local email preview is provided by Mailpit at http://localhost:8025.
# Replace these SMTP settings with your provider's values before deploying.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=DISABLED
SMTP_SSL=false

# Used by the browser; keep the Keycloak URL publicly reachable from the browser.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=dentsuite
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=dentsuite-web
NEXT_PUBLIC_DENTSTAFF_API_URL=http://localhost:8085
KEYCLOAK_ISSUER_URL=http://localhost:8180
